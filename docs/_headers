# Cloudflare Pages: the app page and its data must never be served stale
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/*.json
  Cache-Control: no-cache
/e/*
  Cache-Control: public, max-age=300
# private pages: never in search results
/sources/*
  X-Robots-Tag: noindex, nofollow
/dashboard/*
  X-Robots-Tag: noindex, nofollow
